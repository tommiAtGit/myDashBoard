# .geminiignore - Ignore patterns for Gemini CLI

# Gemini-specific
.gemini/
.geminiignore

# Git
.git/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# .NET Build Results
**/[Dd]ebug/
**/[Rr]elease/
**/bin/
**/obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# IDEs
.vs/
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts
**/build/
**/dist/
**/publish/
**/out/
**/TestResults/

# Environment and Secrets
.env
.env.*
*.pfx
*.publishsettings

# Large binaries and archives
*.zip
*.tar.gz
*.rar
*.7z
*.exe
*.dll
*.pdb

# Package Manager artifacts
package-lock.json
yarn.lock
project.assets.json
*.nuget.props
*.nuget.targets
